<?xml version="1.0" encoding="utf-8"?>
<!-- The slab, as a shape rather than a cornerRadius modifier: Glance's
     cornerRadius is an API 31 feature and silently does nothing below it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/tm_slab" />
    <corners android:radius="32dp" />
</shape>
