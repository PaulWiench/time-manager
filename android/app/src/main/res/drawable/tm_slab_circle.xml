<?xml version="1.0" encoding="utf-8"?>
<!-- The 1x1 widget's ground. A rounded rectangle rather than an oval: a
     launcher cell is rarely square, and an oval stretched into an ellipse
     looks like a mistake. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/tm_slab" />
    <corners android:radius="36dp" />
</shape>
